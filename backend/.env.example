# ---------------------------------------------------------------------------
# SimpleCRM backend configuration.
# Copy this file to `.env` and fill in real values. `.env` is git-ignored.
# ---------------------------------------------------------------------------

# Port the Express server listens on.
PORT=5000

# development | production | test
NODE_ENV=development

# MongoDB connection string.
# Local:  mongodb://127.0.0.1:27017/simplecrm
# Atlas:  mongodb+srv://<user>:<pass>@<cluster>/simplecrm?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27017/simplecrm

# Secret used to sign JWTs. Use a long random string in production, e.g.
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_me_with_a_long_random_string

# How long an access token stays valid (zeit/ms format: "15m", "12h", "7d").
# Kept short: an access token cannot be revoked, so its lifetime IS the window
# in which a leaked one is useful.
ACCESS_TOKEN_TTL=15m

# How long a refresh token stays valid, i.e. how long "stay signed in" lasts.
# This one IS revocable — it is stored (hashed) in the refreshtokens collection.
REFRESH_TOKEN_TTL=7d

# SameSite policy for the auth cookies: lax | strict | none.
# Leave as "lax" when the frontend and API share a domain (the default setup).
# Only set "none" if they are genuinely on different sites, and note that "none"
# requires HTTPS.
COOKIE_SAME_SITE=lax

# DEPRECATED — the single-token setting from before access/refresh tokens.
# Nothing reads it any more; ACCESS_TOKEN_TTL replaced it.
# JWT_EXPIRES_IN=7d

# Set to "true" to skip the Have I Been Pwned check when setting a password.
# The check is privacy-preserving (only a 5-character hash prefix is sent, never
# the password) and fails open if the service is unreachable, so this is only
# needed for an air-gapped deployment or one whose firewall blocks outbound
# HTTPS. The local rules — length, variety, blocklist — always apply.
BREACH_CHECK_DISABLED=false

# How long to keep audit-log entries, in days. Leave unset to keep them forever
# (the default). Even when set, nothing is deleted automatically — run
# `npm run prune-audit -- --yes` deliberately. An audit trail that expires on a
# schedule nobody remembers setting is missing on the day you need it.
# AUDIT_RETENTION_DAYS=365

# The app's own public URL, used to build password-reset links. Defaults to
# CLIENT_ORIGIN (its first entry, since that may be a comma-separated list).
# APP_URL=http://localhost:5173

# Whether anyone may create their own account at /register.
#
#   true   (default) anyone who can reach the sign-up page gets an account, as
#          a sales rep. Convenient; means a stranger can read the customer list.
#   false  accounts exist only because an admin invited someone. Correct for an
#          internal tool, and what a deployment with real customer data on the
#          public internet should use.
#
# The FIRST account on an empty database is always allowed either way, and
# becomes the admin — otherwise closing sign-up would lock you out of a new
# install with no way back in.
# ALLOW_PUBLIC_SIGNUP=false

# How password-reset emails are delivered: console | webhook
#   console  writes the message, including the link, to the log. The default,
#            so the flow works locally with nothing configured. In production
#            this means a reset link ends up in your logs — configure a real
#            transport there.
#   webhook  POSTs { from, to, subject, text } to MAIL_WEBHOOK_URL, sending
#            MAIL_WEBHOOK_AUTH as the Authorization header.
#
# That body is the shape Resend's send endpoint already accepts, so the common
# case needs nothing in between:
#
#   MAIL_TRANSPORT=webhook
#   MAIL_WEBHOOK_URL=https://api.resend.com/emails
#   MAIL_WEBHOOK_AUTH=Bearer re_your_api_key
#   MAIL_FROM=SimpleCRM <no-reply@a-domain-you-verified.com>
#
# MAIL_FROM must be a sender the provider has verified, or it will answer 422.
# A provider with a different payload (Postmark wants From/To/TextBody) needs a
# small relay in between, or one more branch in services/mailer.js.
MAIL_TRANSPORT=console
# MAIL_WEBHOOK_URL=
# Sent verbatim as the Authorization header, so include the scheme.
# MAIL_WEBHOOK_AUTH=Bearer re_your_api_key
# MAIL_FROM=SimpleCRM <no-reply@example.com>

# Log verbosity: fatal | error | warn | info | debug | trace
# Defaults to info in production and debug elsewhere.
# LOG_LEVEL=info

# Origin allowed to call this API from the browser (the Vite dev server).
CLIENT_ORIGIN=http://localhost:5173

# Anthropic API key, used by POST /api/ai-search for natural-language queries.
# Get one at https://aistudio.google.com/apikey. If this is left blank the AI
# search falls back to a plain keyword search and the customer summary is
# generated from the figures rather than written — nothing breaks, but nothing
# is AI either. GET /api/internal/ai-status reports which of the two you are
# actually running.
GEMINI_API_KEY=

# Flash rather than Pro on purpose: every call here is a short prompt with a
# small, strictly-shaped reply, which is latency-sensitive and reasoning-light.
GEMINI_MODEL=gemini-3.6-flash
