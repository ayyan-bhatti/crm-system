# ---------------------------------------------------------------------------
# SimpleCRM backend configuration.
# Copy this file to `.env` and fill in real values. `.env` is git-ignored.
# ---------------------------------------------------------------------------

# Port the Express server listens on.
PORT=5000

# development | production | test
NODE_ENV=development

# MongoDB connection string.
# Local:  mongodb://127.0.0.1:27017/simplecrm
# Atlas:  mongodb+srv://<user>:<pass>@<cluster>/simplecrm?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27017/simplecrm

# Secret used to sign JWTs. Use a long random string in production, e.g.
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_me_with_a_long_random_string

# How long an access token stays valid (zeit/ms format: "15m", "12h", "7d").
# Kept short: an access token cannot be revoked, so its lifetime IS the window
# in which a leaked one is useful.
ACCESS_TOKEN_TTL=15m

# How long a refresh token stays valid, i.e. how long "stay signed in" lasts.
# This one IS revocable — it is stored (hashed) in the refreshtokens collection.
REFRESH_TOKEN_TTL=7d

# SameSite policy for the auth cookies: lax | strict | none.
# Leave as "lax" when the frontend and API share a domain (the default setup).
# Only set "none" if they are genuinely on different sites, and note that "none"
# requires HTTPS.
COOKIE_SAME_SITE=lax

# DEPRECATED — the single-token setting from before access/refresh tokens.
# Nothing reads it any more; ACCESS_TOKEN_TTL replaced it.
# JWT_EXPIRES_IN=7d

# Set to "true" to skip the Have I Been Pwned check when setting a password.
# The check is privacy-preserving (only a 5-character hash prefix is sent, never
# the password) and fails open if the service is unreachable, so this is only
# needed for an air-gapped deployment or one whose firewall blocks outbound
# HTTPS. The local rules — length, variety, blocklist — always apply.
BREACH_CHECK_DISABLED=false

# How long to keep audit-log entries, in days. Leave unset to keep them forever
# (the default). Even when set, nothing is deleted automatically — run
# `npm run prune-audit -- --yes` deliberately. An audit trail that expires on a
# schedule nobody remembers setting is missing on the day you need it.
# AUDIT_RETENTION_DAYS=365

# The app's own public URL, used to build password-reset links. Defaults to
# CLIENT_ORIGIN (its first entry, since that may be a comma-separated list).
# APP_URL=http://localhost:5173

# Whether anyone may create their own account at /register.
#
#   true   (default) anyone who can reach the sign-up page gets an account, as
#          a sales rep. Convenient; means a stranger can read the customer list.
#   false  accounts exist only because an admin invited someone. Correct for an
#          internal tool, and what a deployment with real customer data on the
#          public internet should use.
#
# The FIRST account on an empty database is always allowed either way, and
# becomes the admin — otherwise closing sign-up would lock you out of a new
# install with no way back in.
# ALLOW_PUBLIC_SIGNUP=false

# How password-reset emails are delivered: console | webhook
#   console  writes the message, including the link, to the log. The default,
#            so the flow works locally with nothing configured. In production
#            this means a reset link ends up in your logs — configure a real
#            transport there.
#   webhook  POSTs { from, to, subject, text } to MAIL_WEBHOOK_URL, sending
#            MAIL_WEBHOOK_AUTH as the Authorization header.
#
# That body is the shape Resend's send endpoint already accepts, so the common
# case needs nothing in between:
#
#   MAIL_TRANSPORT=webhook
#   MAIL_WEBHOOK_URL=https://api.resend.com/emails
#   MAIL_WEBHOOK_AUTH=Bearer re_your_api_key
#   MAIL_FROM=SimpleCRM <no-reply@a-domain-you-verified.com>
#
# MAIL_FROM must be a sender the provider has verified, or it will answer 422.
# A provider with a different payload (Postmark wants From/To/TextBody) needs a
# small relay in between, or one more branch in services/mailer.js.
MAIL_TRANSPORT=console
# MAIL_WEBHOOK_URL=
# Sent verbatim as the Authorization header, so include the scheme.
# MAIL_WEBHOOK_AUTH=Bearer re_your_api_key
# MAIL_FROM=SimpleCRM <no-reply@example.com>

# Log verbosity: fatal | error | warn | info | debug | trace
# Defaults to info in production and debug elsewhere.
# LOG_LEVEL=info

# Origin allowed to call this API from the browser (the Vite dev server).
CLIENT_ORIGIN=http://localhost:5173

# Anthropic API key, used by POST /api/ai-search for natural-language queries.
# Get one at https://aistudio.google.com/apikey. If this is left blank the AI
# search falls back to a plain keyword search and the customer summary is
# generated from the figures rather than written — nothing breaks, but nothing
# is AI either. GET /api/internal/ai-status reports which of the two you are
# actually running.
GEMINI_API_KEY=

# Flash rather than Pro on purpose: every call here is a short prompt with a
# small, strictly-shaped reply, which is latency-sensitive and reasoning-light.
GEMINI_MODEL=gemini-3.6-flash

# --- Stripe (test mode) -----------------------------------------------------
# Card payment is OPTIONAL. Left blank, the storefront hides the card option
# and still takes cash-on-delivery orders — nothing breaks.
#
# The two secrets do completely different jobs and swapping them produces a
# confusing failure rather than an obvious one:
#
#   STRIPE_SECRET_KEY      authenticates OUR calls TO Stripe (create a checkout
#                          session, issue a refund). From the dashboard's API
#                          keys page, with Test mode on.
#   STRIPE_WEBHOOK_SECRET  verifies STRIPE'S calls TO US. NOT an API key — it is
#                          the shared secret the signature on an incoming
#                          webhook is computed with. Locally you get it from
#                          `stripe listen --forward-to
#                          localhost:5000/api/shop/stripe/webhook`, which prints
#                          it on start.
#
# SETTING THE FIRST WITHOUT THE SECOND IS THE DANGEROUS STATE: the buyer pays
# happily, Stripe posts the event, we reject the signature, and no order is ever
# created. That failure is invisible from the buyer's side. The app warns about
# it at boot in production.
#
# There is no publishable key here on purpose: this uses Stripe's HOSTED
# checkout page, so no card data ever reaches this server or the browser code.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Where Stripe returns the buyer. Defaults are almost always right.
# STRIPE_SUCCESS_PATH=/order-confirmation
# STRIPE_CANCEL_PATH=/checkout

# --- Marketing channels -----------------------------------------------------
# All three work with NOTHING configured: each falls back to a console
# transport that writes the message to the log. That is not a stub that drops
# mail — the full text is there, so campaigns, the consent gate and the
# post-sale jobs are all exercisable end to end with no accounts and no money.
# GET /api/health reports, per channel, whether a LIVE provider is wired up.

# SMS: console | twilio
# Twilio's REST API wants form-encoded fields and HTTP Basic auth, so unlike
# mail there is no honest "point it at any URL" option — naming the provider is
# more truthful than a generic transport that only works with one payload.
# TWILIO_FROM must be a number Twilio has given you, in E.164.
SMS_TRANSPORT=console
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM=+441234567890

# WhatsApp: console | meta
#
# READ THIS BEFORE SETTING WHATSAPP_TRANSPORT=meta. Outside 24 hours of the
# customer's own last message to the business, WhatsApp accepts ONLY a
# Meta-APPROVED message template — and marketing is outside that window by
# definition, because nobody messages a shop asking to be marketed at. Sending
# free-form text there does not fail loudly; it returns an error that reads
# like a permissions problem and the message never arrives.
#
# So the transport REFUSES to send when WHATSAPP_TEMPLATE_NAME is unset, rather
# than reporting success for a message the platform discarded.
#
# What has to happen on Meta's side first:
#   1. A Meta Business account, with the business verified.
#   2. A WhatsApp Business Account with a phone number registered to it. The
#      number cannot already be on the consumer WhatsApp app.
#   3. A template submitted in WhatsApp Manager under the MARKETING category
#      and APPROVED. Review takes minutes to days, and templates are rejected
#      for wording Meta considers spam-like. Variables are positional: {{1}}.
#   4. A PERMANENT access token from a System User with the
#      whatsapp_business_messaging permission. The token in the Getting Started
#      panel expires in 24 hours and is for testing only.
#   5. Recipients must have opted in through a channel Meta recognises, and
#      Meta audits this. The consent model in this app is what that means here.
#
# WHATSAPP_PHONE_NUMBER_ID is the Cloud API's id for the number, not the number.
WHATSAPP_TRANSPORT=console
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_TEMPLATE_NAME=
# WHATSAPP_TEMPLATE_LANGUAGE=en

# --- Scheduled post-sale jobs -----------------------------------------------
# The shared secret the daily automation run authenticates with. A scheduler
# has no login, no cookie and no CSRF token, so this is a machine credential
# rather than a user session — see routes/cronRoutes.js for why the two
# alternatives (a service account, an IP allow-list) are worse here.
#
# LEFT UNSET, THE ENDPOINT REFUSES EVERY REQUEST. That is deliberate: an
# automation endpoint reachable without credentials is a URL anyone can use to
# make the business send real messages to real people, repeatedly. The
# automations simply do not run until this is set, which is a visible failure
# (the automation screen's last-run date stops moving) rather than a silent one.
#
# On Vercel, add it as CRON_SECRET and the platform's own scheduler sends it as
# a bearer token automatically. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=
