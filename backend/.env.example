# ---------------------------------------------------------------------------
# SimpleCRM backend configuration.
# Copy this file to `.env` and fill in real values. `.env` is git-ignored.
# ---------------------------------------------------------------------------

# Port the Express server listens on.
PORT=5000

# development | production | test
NODE_ENV=development

# MongoDB connection string.
# Local:  mongodb://127.0.0.1:27017/simplecrm
# Atlas:  mongodb+srv://<user>:<pass>@<cluster>/simplecrm?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27017/simplecrm

# Secret used to sign JWTs. Use a long random string in production, e.g.
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_me_with_a_long_random_string

# How long an issued JWT stays valid (zeit/ms format: 60, "2 days", "7d", "10h").
JWT_EXPIRES_IN=7d

# Origin allowed to call this API from the browser (the Vite dev server).
CLIENT_ORIGIN=http://localhost:5173

# Anthropic API key, used by POST /api/ai-search for natural-language queries.
# Get one at https://console.anthropic.com/. If this is left blank the AI search
# endpoint still works — it transparently falls back to a keyword search.
ANTHROPIC_API_KEY=

# Model used for translating natural language into a structured query filter.
ANTHROPIC_MODEL=claude-sonnet-4-6
