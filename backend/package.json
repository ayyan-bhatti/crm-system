{
  "name": "simplecrm-backend",
  "version": "1.0.0",
  "description": "SimpleCRM backend — Express + MongoDB REST API with JWT auth and AI-assisted search",
  "main": "src/server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "seed": "node src/seed.js",
    "test": "cross-env NODE_ENV=test jest --runInBand --detectOpenHandles",
    "test:watch": "cross-env NODE_ENV=test jest --runInBand --watch",
    "lint": "eslint .",
    "indexes": "node scripts/syncIndexes.js",
    "prune-audit": "node scripts/pruneAuditLog.js",
    "backfill-order-numbers": "node scripts/backfillOrderNumbers.js",
    "audit-roles": "node scripts/roleAudit.js"
  },
  "dependencies": {
    "@google/genai": "^2.18.0",
    "bcryptjs": "^3.0.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "express-rate-limit": "^8.6.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.20.1",
    "pino": "^10.3.1",
    "stripe": "^22.6.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.5",
    "globals": "^17.11.0",
    "jest": "^30.2.0",
    "mongodb-memory-server": "^10.2.3",
    "nodemon": "^3.1.10",
    "supertest": "^7.1.4"
  },
  "jest": {
    "testEnvironment": "node",
    "setupFilesAfterEnv": [
      "<rootDir>/tests/setup.js"
    ],
    "testTimeout": 30000
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "packageManager": "npm@10.9.9"
}
